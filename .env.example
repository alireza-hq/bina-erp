DATABASE_URL=postgres://app:replace-me@localhost:5432/employee_work_reporting
LDAP_URL=ldaps://directory.example.internal:636
LDAP_BASE_DN=DC=example,DC=internal
LDAP_DOMAIN=example.internal
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Exact public origin; required when a proxy terminates HTTPS.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production server origin (runtime; overrides NEXT_PUBLIC_APP_URL for CSRF).
# APP_ORIGIN=https://reports.example.internal
DB_POOL_MAX=10
# Enable only behind the documented proxy which OVERWRITES X-Real-IP; block direct app access.
TRUST_PROXY=false
# Explicit exceptions only for a controlled test environment. Production defaults require TLS.
ALLOW_INSECURE_HTTP=false
ALLOW_INSECURE_LDAP=false
