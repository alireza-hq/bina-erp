# Copy to docker.env. Compose reads this file for PostgreSQL, app and operator commands.
# These initialize a NEW named database volume only. Keep the URL credentials in sync.
# Use a strong password (hex is convenient); URL-encode special characters in DATABASE_URL.
POSTGRES_DB=employee_work_reporting
POSTGRES_USER=app
POSTGRES_PASSWORD=replace-me
DATABASE_URL=postgresql://app:replace-me@db:5432/employee_work_reporting
DB_POOL_MAX=10

LDAP_URL=ldaps://directory.example.internal:636
LDAP_BASE_DN=DC=example,DC=internal
LDAP_DOMAIN=example.internal

# Preserve the existing secret when upgrading. Generate a new one only for a fresh install:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
# Single-quote values containing literal dollar signs to prevent Compose interpolation.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Exact browser-facing origin. Nginx terminates TLS and proxies to 127.0.0.1:3000.
APP_ORIGIN=https://reports.example.internal
NEXT_PUBLIC_APP_URL=https://reports.example.internal
# Enable only with the documented Nginx proxy overwriting X-Real-IP.
TRUST_PROXY=true
ALLOW_INSECURE_HTTP=false
ALLOW_INSECURE_LDAP=false

# For localhost-only HTTP testing: set both origins to http://localhost:3000,
# TRUST_PROXY=false and ALLOW_INSECURE_HTTP=true. LDAP still requires valid settings.
# No credentials are provided by this example; fill in all placeholders before startup.
