          "value": "(\"reporting_periods\".\"status\" = 'OPEN' AND \"reporting_periods\".\"locked_at\" IS NULL AND \"reporting_periods\".\"locked_by\" IS NULL) OR (\"reporting_periods\".\"status\" = 'LOCKED' AND \"reporting_periods\".\"locked_at\" IS NOT NULL AND \"reporting_periods\".\"locked_by\" IS NOT NULL)"
