      "checkConstraints": {
        "reporting_period_week_check": {
          "name": "reporting_period_week_check",
          "value": "extract(dow from \"reporting_periods\".\"week_start\") = 6 AND \"reporting_periods\".\"week_end\" = \"reporting_periods\".\"week_start\" + 6 AND \"reporting_periods\".\"week_start\" >= DATE '2000-01-01' AND \"reporting_periods\".\"week_start\" <= DATE '2099-12-31'"
